<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry excluding="exo1/" kind="src" path="collection"/>
	<classpathentry kind="src" path="collection/exo1"/>
	<classpathentry kind="src" path="genericite"/>
	<classpathentry kind="src" path="heritage"/>
	<classpathentry kind="src" path="JDBC/src"/>
	<classpathentry kind="src" path="linkedList"/>
	<classpathentry kind="lib" path="JDBC/lib/mysql-connector-j-8.2.0.jar"/>
	<classpathentry kind="lib" path="JDBC/lib/mysql-connector-java-8.0.13.jar"/>
	<classpathentry kind="output" path="JDBC/bin"/>
</classpath>
